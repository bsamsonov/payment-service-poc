{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "scope", "summary", "reason", "files"],
  "properties": {
    "status": {"type": "string", "enum": ["fixed", "declined"]},
    "scope": {"type": "string", "description": "Conventional Commits scope of the fix"},
    "summary": {"type": "string", "description": "Imperative, lowercase commit subject, at most 60 characters"},
    "reason": {"type": "string"},
    "files": {"type": "array", "items": {"type": "string"}}
  }
}
