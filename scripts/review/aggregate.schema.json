{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "findings",
    "rejected",
    "attention",
    "must_review",
    "skim",
    "previous",
    "reviewers"
  ],
  "properties": {
    "summary": {
      "type": "array",
      "description": "What the PR changes, 3-5 short lines.",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "description": "Confirmed findings, ordered by severity then risk.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "severity",
          "path",
          "line",
          "in_diff",
          "rule",
          "sources",
          "body"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "F1, F2, ... in this round"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "path": {
            "type": "string",
            "description": "Path relative to the repository root"
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "description": "Line in the post-change file"
          },
          "in_diff": {
            "type": "boolean",
            "description": "The line is an added or context line of the PR diff"
          },
          "rule": {
            "type": "string",
            "description": "RC-NN if a checklist rule applies, else empty"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Reviewer ids that reported it"
          },
          "body": {
            "type": "string",
            "description": "Comment text: problem, scenario, suggested fix"
          }
        }
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "title",
          "reason"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "attention": {
      "type": "array",
      "description": "Architect's attention: at most 7 decisions that are hard to reverse, shape later specs or set a precedent; most important first.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "title",
          "path",
          "line",
          "why",
          "question"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "irreversible",
              "architecture",
              "precedent",
              "minor"
            ]
          },
          "title": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "why": {
            "type": "string",
            "description": "Why it matters later: what becomes expensive to change and which spec or flow it affects."
          },
          "question": {
            "type": "string"
          }
        }
      }
    },
    "must_review": {
      "type": "array",
      "description": "At most 10 places for the human reviewer, ordered by risk.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "line",
          "risk",
          "question"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "risk": {
            "type": "string"
          },
          "question": {
            "type": "string"
          }
        }
      }
    },
    "skim": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what",
          "why"
        ],
        "properties": {
          "what": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "previous": {
      "type": "array",
      "description": "Delta mode: status of every previous finding; empty otherwise.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "fixed",
              "not_fixed",
              "partially_fixed"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "reviewers": {
      "type": "array",
      "description": "Per raw report: reviewer id and the number of distinct findings it raised (checklist: failed rules).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "raw_findings"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "raw_findings": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
