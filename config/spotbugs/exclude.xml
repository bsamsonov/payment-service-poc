<?xml version="1.0" encoding="UTF-8"?>
<!-- Suppressions must be justified. Keep this list short. -->
<FindBugsFilter>
    <!-- Spring beans and records routinely hold references to injected/immutable collaborators. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- Generated from api/openapi.yaml (ADR-0006); not our code, analyzed through the contract instead. -->
    <Match>
        <Package name="~io\.github\.bsamsonov\.paymentservice\.adapter\.in\.web\.(api|model)"/>
    </Match>
    <!-- Insert-only journal entities (spec 001): the application writes the rows and never reads them back;
         they are read with SQL (audit, tests). Hibernate reads the fields reflectively on insert. -->
    <Match>
        <Or>
            <Class name="io.github.bsamsonov.paymentservice.adapter.out.persistence.PaymentEventEntity"/>
            <Class name="io.github.bsamsonov.paymentservice.adapter.out.persistence.RejectedRequestEntity"/>
        </Or>
        <Bug pattern="URF_UNREAD_FIELD"/>
    </Match>
</FindBugsFilter>
